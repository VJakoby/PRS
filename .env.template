# Copy this file to `.env` for your local setup.
# The generated `.env` is local-only and should not be committed.

# Primary local notes directory on the host.
# Mounted inside Docker at `/app/notes`.
# If all markdown notes live under one parent directory, this is usually the only value you need.
NOTES_PATH=

# Optional additional host note directories for unrelated roots.
# Mounted inside Docker at `/app/notes-2` and `/app/notes-3`.
# If unused, leave them empty and disable the matching `offline_sources` entries in `sources.json`.
# Empty values fall back to internal empty directories.
NOTES_PATH_2=
NOTES_PATH_3=

# Indexing rate override.
# Default is controlled by the application if left empty.
# Indexing rate; Default: 1000 (hardcoded)
RATE=
