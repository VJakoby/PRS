{
  "name": "engram-knowledge-base-indexer",
  "version": "1.0",
  "description": "High-performance indexed search engine for local knowledge bases with fuzzy matching and advanced scoring.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "index": "node indexer.js build",
    "update": "node indexer.js update",
    "cache": "node indexer.js cache",
    "cache-status": "node indexer.js cache-status",
    "remove": "node indexer.js remove",
    "search": "node indexer.js search",
    "info": "node indexer.js info",
    "docker:build": "docker compose build",
    "docker:index": "docker compose run --rm app npm run index",
    "docker:cache": "docker compose run --rm app npm run cache",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.13.5",
    "cors": "^2.8.5",
    "cheerio": "^1.0.0-rc.12"
  },
  "keywords": [
    "search",
    "indexer",
    "kb"
  ],
  "author": "VJakoby",
  "license": "MIT"
}
