{
  "name": "engram-indexed-search-surface",
  "version": "1.0.0",
  "description": "ENGRAM - Indexed Search Surface",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VJakoby/engram-Indexed-Search-Surface.git"
  },
  "main": "server.js",

  "scripts": {
    "start": "node server.js",
    "index": "node indexer.js build ",
    "cache": "node indexer.js cache",
    "cache-status": "node indexer.js cache-status",
    "info": "node indexer.js info",
    "search": "node indexer.js search",
    "update": "node indexer.js update",
    "remove": "node indexer.js remove",
    "backup": "node node scripts/backup",
    "restore": "node scripts/restore",
    "help": "node indexer.js --help",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:index": "docker compose run --rm engram npm run index",
    "docker:index:force": "docker compose run --rm engram npm run index -- --force",
    "docker:index:local": "docker compose run --rm engram npm run index -- --local",
    "docker:index:online": "docker compose run --rm engram npm run index -- --online",
    "docker:index:help": "docker compose run --rm engram npm run help",
    "docker:cache": "docker compose run --rm engram npm run cache"
  },
  "keywords": [
    "knowledge-base",
    "indexer",
    "search"
  ],
  "author": "VJakoby + 🤖",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "marked": "^11.0.0",
    "cors": "^2.8.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
